# Internal Policy Q&A Service — environment configuration template
# Copy this file to .env and fill in values. Never commit the real .env.

# Application metadata
APP_NAME="Internal Policy Q&A Service"
APP_VERSION="0.1.0"
APP_DESCRIPTION="Answers questions using internal Markdown policy documents, with citations."

# Location of the Markdown policy documents (used in later milestones).
DOCUMENTS_DIR="documents/policies"

# Sub-path when served behind a reverse proxy under a prefix (e.g. "/proxy/46453").
# Leave empty for direct/local access.
ROOT_PATH=

# Ingestion chunking parameters (characters). Defaults are used if unset.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Embedding / vector search (Milestone 3). EMBEDDING_DIM must match the model.
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384
INDEX_DIR="vector_store"
TOP_K=5

# Groq LLM answer generation (Milestone 4).
# GROQ_API_KEY is required to generate answers but is read lazily, so the app
# still starts without it. Never commit a real key.
GROQ_API_KEY="your_groq_api_key"
# Groq chat-completions model id (defaults to llama-3.3-70b-versatile if unset).
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30.0

# Retrieval relevance floor for refusal. If the best matching chunk scores below
# this cosine similarity, the service refuses without calling the LLM.
ANSWER_MIN_SCORE=0.25

# API-key authentication. Clients must send this value in the X-API-Key header.
# The service fails closed if this is unset (protected endpoints reject all
# requests). Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real key.
API_KEY="your_api_key"

# --- Abuse protection ---
# Rate limiting for POST /ask (per API key). In-memory, per process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum request body size (bytes) -> 413, and maximum question length (chars) -> 422.
MAX_REQUEST_BYTES=16384
MAX_QUESTION_CHARS=2000

# (GROQ_MAX_TOKENS caps LLM output tokens; GROQ_TIMEOUT_SECONDS bounds the Groq
#  request — both are configured in the Groq section above.)